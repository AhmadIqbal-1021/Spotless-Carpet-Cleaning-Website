# Spotless Carpet Cleaning — environment configuration
#
# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored and must never be committed.
#
# All variables below are public (NEXT_PUBLIC_*) because they are
# used directly in client-facing links (WhatsApp, tel:, mailto:).
# Do NOT put secrets in NEXT_PUBLIC_* variables.

# WhatsApp number in international format, digits only, no "+" or spaces.
# Example: 447123456789
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Business phone number as it should appear in tel: links.
# Example: +441234567890
NEXT_PUBLIC_BUSINESS_PHONE=

# Business contact email address shown for enquiries.
NEXT_PUBLIC_BUSINESS_EMAIL=

# --- Contact form provider (to be configured before go-live) ---
# The quote form on /contact currently only validates input on the
# client and server; it does not yet send anywhere. Once a form/email
# provider is chosen (e.g. Formspree, Resend, Web3Forms), add the
# required variables here and wire them into app/contact/actions.ts.
# FORM_PROVIDER_API_KEY=
